# ─────────────────────────────────────────────────────────────────────────────
# NOUROU GLOBAL ACADEMY — variables d'environnement (EXEMPLE, aucune valeur réelle)
# Copier en .env puis compléter. Ne jamais committer le fichier .env.
# ─────────────────────────────────────────────────────────────────────────────

# Environnement : development | staging | production
# En production, le mode de paiement de démonstration est désactivé d'office.
APP_ENV="development"
APP_URL="http://localhost:3000"

# Base PostgreSQL 15+ avec l'extension pgvector (Supabase : utiliser les URL « pooler » et « direct »)
DATABASE_URL="postgresql://nourou:MOT_DE_PASSE@localhost:5432/nourou_academy?schema=public"
DIRECT_URL="postgresql://nourou:MOT_DE_PASSE@localhost:5432/nourou_academy?schema=public"

# Secrets applicatifs — générer chacun avec : openssl rand -base64 48
SESSION_SECRET=""
# Chiffre les clés API saisies dans l'administration. NE PAS la changer après mise en service
# (sinon les clés enregistrées deviennent illisibles et doivent être ressaisies).
SETTINGS_ENCRYPTION_KEY=""
FILE_SIGNING_SECRET=""
# Protège les tâches planifiées /api/cron/* (en-tête Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Paiements de démonstration (jamais actifs si APP_ENV=production)
PAYMENT_DEMO_ENABLED="true"

# Compte super-administrateur créé par `npm run db:seed`
SEED_ADMIN_EMAIL="admin@votre-domaine.com"
SEED_ADMIN_PASSWORD=""
# Données de démonstration (formations, formateurs fictifs) : "false" pour ne pas les créer
SEED_DEMO="true"

# ── Stockage des fichiers ──
# local : disque du serveur (STORAGE_LOCAL_DIR) | s3 : AWS S3, Cloudflare R2, Wasabi, MinIO, Supabase Storage (S3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Clés facultatives (peuvent aussi être saisies, chiffrées, dans Administration › Paramètres) ──
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
CINETPAY_API_KEY=""
CINETPAY_SECRET_KEY=""
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
JITSI_DOMAIN="meet.jit.si"
JITSI_APP_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE="false"
