                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generated_at": {
              "$ref": "#/definitions/date_time"
            },
            "generator": {
              "type": "object",
