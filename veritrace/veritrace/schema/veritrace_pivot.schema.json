          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "version",
              "title",
              "enabled",
              "hits"
            ],
            "additionalProperties": false,
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "hits": {
                "type": "integer",
                "minimum": 0
              },
              "parameters": {
                "type": "object"
              }
            }
          }
        }
      }
