# Site web DREAD ROYAL : export statique Next.js servi par Caddy (HTTPS automatique)
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @dread-royal/shared --workspace @dread-royal/web --include-workspace-root=false
COPY packages/shared packages/shared
COPY apps/web apps/web
# Même domaine que l'API : chemin relatif, aucun problème de CORS
ENV NEXT_PUBLIC_API_URL=/api NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w @dread-royal/shared && npm run build -w @dread-royal/web

FROM caddy:2-alpine
COPY --from=build /app/apps/web/out /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
