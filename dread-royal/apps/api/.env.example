# Base PostgreSQL
DATABASE_URL="postgresql://dreadroyal:dreadroyal_dev@localhost:5432/dread_royal?schema=public"
# Secret JWT : générer avec `openssl rand -hex 48` — NE JAMAIS le mettre dans le frontend
JWT_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS=30
PORT=4000
# Origines autorisées (web, PWA, Capacitor Android), séparées par des virgules
CORS_ORIGINS="http://localhost:3000,capacitor://localhost,https://localhost,http://localhost"
# Sauvegardes automatiques
BACKUP_DIR="../../backups"
BACKUP_CRON="0 2 * * *"
BACKUP_KEEP=30
# Fuseau horaire du salon (Burkina Faso = UTC+0)
TZ="Africa/Ouagadougou"
# Compte propriétaire initial (créé par le seed si aucun utilisateur)
OWNER_USERNAME="proprietaire"
OWNER_PASSWORD="DreadRoyal@2026"
