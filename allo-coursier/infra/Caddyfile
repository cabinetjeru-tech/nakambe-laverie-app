# Proxy HTTPS (certificat Let's Encrypt automatique et gratuit).
{$DOMAIN} {
	encode zstd gzip

	# API et temps réel (WebSocket pris en charge automatiquement)
	handle /api/* {
		reverse_proxy api:3002
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
