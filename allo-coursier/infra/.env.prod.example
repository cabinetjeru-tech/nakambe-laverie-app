# Nom de domaine pointant vers le serveur (enregistrement DNS de type A)
DOMAIN=allo-coursier.com

# Base de données — mot de passe long et aléatoire (ex. : openssl rand -base64 24)
POSTGRES_USER=allo
POSTGRES_DB=allo_coursier
POSTGRES_PASSWORD=

# Secret de signature des sessions — 32 caractères minimum (ex. : openssl rand -base64 48)
JWT_ACCESS_SECRET=

# Notifications push : docker compose ... run --rm api npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@allo-coursier.bf

# Premier super-administrateur (créé par le seed ; changez le mot de passe ensuite)
SEED_ADMIN_PHONE=+22670000000
SEED_ADMIN_PASSWORD=
