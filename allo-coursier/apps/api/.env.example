# Connexion PostgreSQL
DATABASE_URL="postgresql://allo:allo_dev_pwd@localhost:5432/allo_coursier?schema=public"

# Secrets JWT — À CHANGER EN PRODUCTION (chaînes longues et aléatoires)
JWT_ACCESS_SECRET="change-moi-access"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30

PORT=3002
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS="http://localhost:3000"

# Compte super-administrateur créé par le seed
SEED_ADMIN_PHONE="+22670000000"
SEED_ADMIN_PASSWORD="AlloAdmin@2026"

# Dossier où sont enregistrées les photos (preuves, tickets, documents des livreurs)
UPLOAD_DIR="./uploads"

# Notifications push (gratuites). Générer une paire de clés avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@allo-coursier.bf"
