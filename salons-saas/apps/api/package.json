{
  "name": "@salons-saas/api",
  "version": "0.1.0",
  "private": true,
  "description": "API SaaS de gestion de salons de coiffure (NestJS + Prisma + PostgreSQL, multi-tenant)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "platform:grant": "ts-node --transpile-only prisma/grant-platform.ts",
    "db:roles": "psql \"$ADMIN_DATABASE_URL\" -v ON_ERROR_STOP=1 -v owner_role=\"$DB_OWNER_ROLE\" -v app_password=\"'$APP_DB_PASSWORD'\" -v platform_password=\"'$PLATFORM_DB_PASSWORD'\" -f prisma/sql/roles.sql",
    "db:verify": "psql \"$ADMIN_DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/sql/verification.sql"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.5",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
