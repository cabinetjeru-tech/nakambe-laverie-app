# ---------------------------------------------------------------------------
# API salons-saas — copier en .env puis remplir. Tout est validé au démarrage
# (src/config/env.ts) : l'API refuse de démarrer si une valeur est invalide.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3002

# Connexion de l'API : rôle salons_app, SOUMIS à la Row-Level Security (voir prisma/sql/roles.sql).
DATABASE_URL=postgresql://salons_app:CHANGER@localhost:5432/salons
# Rôle propriétaire des tables : migrations et seed uniquement, jamais utilisé par l'API.
DATABASE_MIGRATION_URL=postgresql://salons_owner:CHANGER@localhost:5432/salons

# Secrets — générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=
HASH_PEPPER=
# Clé maîtresse de 32 octets — générer avec : openssl rand -base64 32
MASTER_KEY=

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Origines autorisées (séparées par des virgules) et URL publique de l'application web
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
# true derrière Caddy/Nginx (adresse IP réelle du client pour la limitation de débit)
TRUST_PROXY=false
# Forcé à true en production
COOKIE_SECURE=false

# Envoi des codes : console (écrits dans les journaux) tant qu'aucun fournisseur SMS/WhatsApp n'est branché
OTP_DRIVER=console

# Offre attribuée à l'inscription (période d'essai)
DEFAULT_PLAN_CODE=SALON
TRIAL_DAYS=30

# ---------------------------------------------------------------------------
# Facturation de la plateforme (abonnements des salons)
# ---------------------------------------------------------------------------
# Connexion salons_platform (BYPASSRLS) : moteur de facturation et console éditeur
PLATFORM_DATABASE_URL=postgresql://salons_platform:CHANGER@localhost:5432/salons
BILLING_SCHEDULER=on
# Valeurs par défaut : délais, TVA, coordonnées et numéros Mobile Money ci-dessous sont
# ensuite modifiables dans la console super administrateur (/plateforme → Paramètres).
BILLING_TICK_SECONDS=300
BILLING_RENEWAL_LEAD_DAYS=7
BILLING_GRACE_DAYS=3
# TVA sur les factures de la plateforme (à confirmer avec votre comptable)
BILLING_VAT_PERCENT=0
PLATFORM_LEGAL_NAME=Mon Entreprise SARL
PLATFORM_ADDRESS=Ouagadougou, Burkina Faso
PLATFORM_TAX_ID=
# Numéros où les salons envoient leurs paiements Mobile Money
PLATFORM_MOBILE_MONEY=Orange Money:+22670000000;Moov Money:+22660000000
# Paiement en ligne : none | cinetpay | sandbox (simulateur, hors production)
PAYMENT_PROVIDER=none
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
API_PUBLIC_URL=http://localhost:3002
