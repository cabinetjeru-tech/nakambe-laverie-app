// ============================================================================
// SALONS-SAAS — Schéma de base de données multi-tenant
// Voir docs/01-ARCHITECTURE.md (§3, §4) et docs/02-BASE-DE-DONNEES.md.
//
// Règles appliquées partout :
// - Tables « plateforme » (sans tenant_id) : users, plans, tenants, abonnements SaaS…
// - Tables « tenant » : colonne tenant_id + Row-Level Security (migration securite_postgres).
// - Chaque table tenant expose @@unique([tenantId, id]) et ses clés étrangères vers d'autres
//   tables tenant sont COMPOSITES (tenant_id, x_id) : un enregistrement du tenant A ne peut
//   jamais pointer vers un enregistrement du tenant B, même en cas de bug applicatif.
//   Conséquence : pour détacher une relation facultative, écrire `xId: null` (jamais
//   `disconnect`, qui tenterait aussi de vider tenant_id).
// - Argent : BigInt en unité mineure de la devise (XOF : 1 = 1 FCFA). Jamais de Float.
// - Dates : timestamptz (UTC). Le fuseau du salon sert à l'affichage et aux horaires.
// - Prix, durées et taux de commission sont COPIÉS dans les lignes de RDV/vente (figés).
// - created_by / updated_by : id d'utilisateur sans clé étrangère (survit à l'anonymisation).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. PLATEFORME — identités, offres, tenants, abonnements SaaS
// ============================================================================

enum UserStatus {
  ACTIVE
  LOCKED // verrouillé après trop d'échecs de connexion
  DISABLED
}

/// Identité globale d'une personne (employé d'un ou plusieurs salons et/ou client).
model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  phone           String     @unique // format E.164, ex. +22670000000
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(3)
  email           String?    @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  fullName        String     @map("full_name")
  passwordHash    String?    @map("password_hash") // null tant que le compte n'est pas activé (invitation, OTP)
  mfaSecretEnc    String?    @map("mfa_secret_enc") // secret TOTP chiffré (AES-256-GCM)
  mfaEnabledAt    DateTime?  @map("mfa_enabled_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(3)
  locale          String     @default("fr")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  anonymizedAt    DateTime?  @map("anonymized_at") @db.Timestamptz(3)

  sessions          UserSession[]
  platformStaff     PlatformStaff?
  memberships       Membership[]
  clientProfiles    ClientProfile[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

/// Session = famille de refresh tokens (rotation à chaque usage, détection de réutilisation).
model UserSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid // toutes les rotations d'une même connexion
  refreshTokenHash String    @unique @map("refresh_token_hash")
  activeTenantId   String?   @map("active_tenant_id") @db.Uuid // tenant sélectionné dans le back-office
  deviceLabel      String?   @map("device_label")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz(3) // non nul = jeton déjà utilisé
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("user_sessions")
}

/// Codes à usage unique (OTP SMS/WhatsApp, réinitialisation, vérification email).
model VerificationCode {
  id        String              @id @default(uuid(7)) @db.Uuid
  target    String // téléphone ou email
  purpose   VerificationPurpose
  codeHash  String              @map("code_hash")
  attempts  Int                 @default(0)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([target, purpose])
  @@map("verification_codes")
}

enum VerificationPurpose {
  LOGIN
  PHONE_VERIFICATION
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_SUPPORT
  PLATFORM_BILLING
}

model PlatformStaff {
  userId    String       @id @map("user_id") @db.Uuid
  role      PlatformRole
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_staff")
}

/// Catalogue global des codes de permission (synchronisé depuis packages/shared).
model Permission {
  code        String  @id // ex. "appointments.manage"
  groupName   String  @map("group_name")
  description String
  featureCode String? @map("feature_code") // fonctionnalité d'offre requise, ex. "stock"

  rolePermissions RolePermission[]

  @@map("permissions")
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/// Offre commerciale (Solo, Salon, Multi-salons…).
model Plan {
  id              String   @id @default(uuid(7)) @db.Uuid
  code            String   @unique // ex. "SOLO", "SALON", "MULTI"
  name            String
  description     String?
  currency        String   @default("XOF") @db.Char(3)
  priceMonthly    BigInt   @map("price_monthly")
  priceYearly     BigInt   @map("price_yearly")
  maxSalons       Int?     @map("max_salons") // null = illimité
  maxStaff        Int?     @map("max_staff")
  smsQuotaMonthly Int      @default(0) @map("sms_quota_monthly")
  storageQuotaMb  Int      @default(500) @map("storage_quota_mb")
  isPublic        Boolean  @default(true) @map("is_public")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  features      PlanFeature[]
  tenants       Tenant[]
  subscriptions SaasSubscription[]
  pendingFor    SaasSubscription[] @relation("PendingPlan")
  invoices      SaasInvoice[]

  @@map("plans")
}

/// Fonctionnalité incluse dans une offre (online_booking, stock, commissions, custom_roles…).
model PlanFeature {
  planId      String @map("plan_id") @db.Uuid
  featureCode String @map("feature_code")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureCode])
  @@map("plan_features")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED // lecture seule
  CANCELLED
}

/// Entreprise cliente de la plateforme. Porte l'abonnement SaaS.
model Tenant {
  id               String       @id @default(uuid(7)) @db.Uuid
  slug             String       @unique // sous-domaine : {slug}.plateforme.bf
  legalName        String       @map("legal_name")
  displayName      String       @map("display_name")
  countryCode      String       @default("BF") @map("country_code") @db.Char(2)
  currency         String       @default("XOF") @db.Char(3)
  timezone         String       @default("Africa/Ouagadougou")
  taxId            String?      @map("tax_id") // IFU
  tradeRegister    String?      @map("trade_register") // RCCM
  logoKey          String?      @map("logo_key") // clé dans le stockage objet
  status           TenantStatus @default(TRIAL)
  planId           String       @map("plan_id") @db.Uuid
  trialEndsAt      DateTime?    @map("trial_ends_at") @db.Timestamptz(3)
  graceEndsAt      DateTime?    @map("grace_ends_at") @db.Timestamptz(3) // fin du délai de grâce (impayé)
  suspendedAt      DateTime?    @map("suspended_at") @db.Timestamptz(3)
  suspensionReason String?      @map("suspension_reason")
  shard            String       @default("main") // base physique (porte de sortie vers une base dédiée)
  dataKeyEnc       String       @map("data_key_enc") // clé de chiffrement du tenant, chiffrée par la clé maîtresse
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt      DateTime?    @map("cancelled_at") @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id])

  domains               TenantDomain[]
  subscriptions         SaasSubscription[]
  saasInvoices          SaasInvoice[]
  saasPayments          SaasPayment[]
  usageCounters         UsageCounter[]
  featureOverrides      FeatureOverride[]
  impersonationGrants   ImpersonationGrant[]
  supportTickets        SupportTicket[]
  supportMessages       SupportMessage[]
  settings              TenantSetting[]
  salons                Salon[]
  roles                 Role[]
  memberships           Membership[]
  invitations           Invitation[]
  staffMembers          StaffMember[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  servicePackages       ServicePackage[]
  clientProfiles        ClientProfile[]
  suppliers             Supplier[]
  products              Product[]
  expenseCategories     ExpenseCategory[]
  commissionRules       CommissionRule[]
  payrollPeriods        PayrollPeriod[]
  loyaltyProgram        LoyaltyProgram?
  giftCards             GiftCard[]
  prepaidPackages       PrepaidPackage[]
  promotions            Promotion[]
  notificationTemplates NotificationTemplate[]
  campaigns             Campaign[]
  documentSequences     DocumentSequence[]
  webhookEndpoints      WebhookEndpoint[]
  apiKeys               ApiKey[]
  auditLogs             AuditLog[]
  outboxEvents          OutboxEvent[]

  @@map("tenants")
}

enum DomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model TenantDomain {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  hostname          String       @unique // ex. reservation.beaute-divine.com
  salonId           String?      @map("salon_id") @db.Uuid // page d'un salon précis, sinon page du tenant
  verificationToken String       @map("verification_token")
  status            DomainStatus @default(PENDING)
  verifiedAt        DateTime?    @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

enum SaasSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Abonnement du tenant à la plateforme : une ligne courante par tenant, qui évolue
/// (essai → actif → impayé…). L'historique des périodes est porté par les factures.
/// L'essai est une période comme une autre (prix 0) : current_period_end = fin d'essai.
model SaasSubscription {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  planId             String                 @map("plan_id") @db.Uuid
  cycle              BillingCycle
  status             SaasSubscriptionStatus
  unitPrice          BigInt                 @map("unit_price") // prix figé à la souscription
  currency           String                 @db.Char(3)
  currentPeriodStart DateTime               @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime               @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean                @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?              @map("cancelled_at") @db.Timestamptz(3)
  /// Changement d'offre ou de cycle appliqué au prochain renouvellement.
  pendingPlanId      String?                @map("pending_plan_id") @db.Uuid
  pendingCycle       BillingCycle?          @map("pending_cycle")
  pastDueSince       DateTime?              @map("past_due_since") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan        Plan          @relation(fields: [planId], references: [id])
  pendingPlan Plan?         @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  invoices    SaasInvoice[]

  @@unique([tenantId])
  @@index([status, currentPeriodEnd])
  @@map("saas_subscriptions")
}

enum SaasInvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum SaasInvoiceKind {
  RENEWAL // période suivante (y compris la première après l'essai)
  UPGRADE // différence au prorata lors d'un passage à une offre supérieure
}

/// Facture émise par l'éditeur au tenant.
model SaasInvoice {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  subscriptionId String?           @map("subscription_id") @db.Uuid
  number         String            @unique // numérotation de l'éditeur : FS-2026-000001
  kind           SaasInvoiceKind   @default(RENEWAL)
  planId         String            @map("plan_id") @db.Uuid
  cycle          BillingCycle
  description    String
  status         SaasInvoiceStatus @default(DRAFT)
  periodStart    DateTime          @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime          @map("period_end") @db.Timestamptz(3)
  subtotal       BigInt
  taxAmount      BigInt            @default(0) @map("tax_amount")
  total          BigInt
  currency       String            @db.Char(3)
  dueAt          DateTime          @map("due_at") @db.Timestamptz(3)
  paidAt         DateTime?         @map("paid_at") @db.Timestamptz(3)
  voidedAt       DateTime?         @map("voided_at") @db.Timestamptz(3)
  voidReason     String?           @map("void_reason")
  /// Identité de l'acheteur figée à l'émission (raison sociale, IFU, RCCM).
  buyerSnapshot  Json              @map("buyer_snapshot")
  pdfKey         String?           @map("pdf_key")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription SaasSubscription? @relation(fields: [subscriptionId], references: [id])
  plan         Plan              @relation(fields: [planId], references: [id])
  payments     SaasPayment[]

  @@index([tenantId, status])
  @@index([status, dueAt])
  @@map("saas_invoices")
}

/// Paiement d'une facture de la plateforme. Mobile Money manuel (référence vérifiée par
/// l'éditeur), agrégateur en ligne (CinetPay, confirmé par interrogation de l'agrégateur)
/// ou bac à sable (développement et tests uniquement).
model SaasPayment {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  method            PaymentMethod
  provider          String? // "cinetpay", "sandbox"
  status            PaymentStatus @default(PENDING)
  amount            BigInt
  currency          String        @db.Char(3)
  providerReference String?       @map("provider_reference") // référence Mobile Money saisie / id opérateur
  providerToken     String?       @unique @map("provider_token") // identifiant de transaction chez l'agrégateur
  checkoutUrl       String?       @map("checkout_url")
  operator          String?
  payerPhone        String?       @map("payer_phone")
  idempotencyKey    String        @unique @map("idempotency_key")
  rawPayload        Json?         @map("raw_payload")
  failureReason     String?       @map("failure_reason")
  validatedBy       String?       @map("validated_by") @db.Uuid
  createdBy         String?       @map("created_by") @db.Uuid
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice SaasInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([method, providerReference])
  @@index([status, method])
  @@index([tenantId])
  @@map("saas_payments")
}

/// Paramètres de la plateforme modifiables par le super administrateur (coordonnées de
/// l'éditeur, numéros Mobile Money, délais de facturation…). Une clé absente = valeur de
/// l'environnement (.env).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

enum SupportTicketStatus {
  OPEN // en attente de l'équipe plateforme
  PENDING // réponse de la plateforme, en attente du salon
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Demande d'assistance d'un salon à l'équipe de la plateforme.
model SupportTicket {
  id              String                @id @default(uuid(7)) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  number          Int // numéro continu par entreprise
  subject         String
  category        String // billing, bug, question, account, other
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(NORMAL)
  createdByUserId String                @map("created_by_user_id") @db.Uuid
  assignedToId    String?               @map("assigned_to_id") @db.Uuid // agent plateforme
  lastMessageAt   DateTime              @default(now()) @map("last_message_at") @db.Timestamptz(3)
  resolvedAt      DateTime?             @map("resolved_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  messages SupportMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([status, lastMessageAt])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  fromPlatform Boolean  @default(false) @map("from_platform")
  /// Note interne de l'équipe plateforme : jamais visible du salon.
  internal     Boolean  @default(false)
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ticket SupportTicket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, ticketId, createdAt])
  @@map("support_messages")
}

/// Numérotation continue des pièces de l'éditeur (factures de la plateforme).
model PlatformSequence {
  docType String @map("doc_type")
  year    Int
  value   Int    @default(0)

  @@id([docType, year])
  @@map("platform_sequences")
}

/// Consommation par tenant et par période (SMS, stockage, rendez-vous) pour les quotas.
model UsageCounter {
  tenantId    String   @map("tenant_id") @db.Uuid
  metric      String // "sms", "whatsapp", "storage_mb", "appointments"
  periodStart DateTime @map("period_start") @db.Date
  value       BigInt   @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, metric, periodStart])
  @@map("usage_counters")
}

/// Activation/désactivation manuelle d'une fonctionnalité pour un tenant.
model FeatureOverride {
  tenantId    String    @map("tenant_id") @db.Uuid
  featureCode String    @map("feature_code")
  enabled     Boolean
  reason      String?
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, featureCode])
  @@map("feature_overrides")
}

/// Accès du support plateforme accordé explicitement par le propriétaire du salon.
model ImpersonationGrant {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  supportUserId   String?   @map("support_user_id") @db.Uuid // null = n'importe quel agent support
  reason          String
  readOnly        Boolean   @default(true) @map("read_only")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
  @@map("impersonation_grants")
}

// ============================================================================
// 2. ORGANISATION — salons, horaires, ressources, paramètres
// ============================================================================

model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String // ex. "booking.cancellation_hours", "sales.stylist_can_checkout"
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

enum SalonStatus {
  ACTIVE
  INACTIVE
}

/// Établissement physique d'un tenant.
model Salon {
  id                      String      @id @default(uuid(7)) @db.Uuid
  tenantId                String      @map("tenant_id") @db.Uuid
  slug                    String // page publique : {tenant}.plateforme.bf/{slug}
  name                    String
  phone                   String?
  whatsapp                String?
  email                   String?
  addressLine             String?     @map("address_line")
  landmark                String? // repère : « derrière la pharmacie X »
  city                    String
  countryCode             String      @default("BF") @map("country_code") @db.Char(2)
  gpsLat                  Float?      @map("gps_lat")
  gpsLng                  Float?      @map("gps_lng")
  timezone                String      @default("Africa/Ouagadougou")
  currency                String      @default("XOF") @db.Char(3)
  status                  SalonStatus @default(ACTIVE)
  onlineBookingEnabled    Boolean     @default(true) @map("online_booking_enabled")
  bookingMinNoticeMinutes Int         @default(60) @map("booking_min_notice_minutes")
  bookingMaxAdvanceDays   Int         @default(60) @map("booking_max_advance_days")
  cancellationNoticeHours Int         @default(12) @map("cancellation_notice_hours")
  slotIntervalMinutes     Int         @default(15) @map("slot_interval_minutes")
  defaultDepositPercent   Int         @default(0) @map("default_deposit_percent")
  invoicePrefix           String      @default("F") @map("invoice_prefix")
  receiptFooter           String?     @map("receipt_footer")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?   @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  openingHours     SalonOpeningHour[]
  closures         SalonClosure[]
  resources        Resource[]
  membershipSalons MembershipSalon[]
  staffSalons      StaffSalon[]
  staffSchedules   StaffSchedule[]
  timeClockEntries TimeClockEntry[]
  servicePrices    ServiceSalonPrice[]
  appointments     Appointment[]
  waitlistEntries  WaitlistEntry[]
  bookingHolds     BookingHold[]
  preferredBy      ClientProfile[]
  sales            Sale[]
  cashRegisters    CashRegister[]
  invoices         Invoice[]
  productStocks    ProductStock[]
  stockMovements   StockMovement[]
  purchaseOrders   PurchaseOrder[]
  transfersOut     StockTransfer[]     @relation("TransferFrom")
  transfersIn      StockTransfer[]     @relation("TransferTo")
  expenses         Expense[]
  reviews          Review[]
  complaints       Complaint[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@map("salons")
}

/// Horaires d'ouverture (plusieurs plages par jour possibles).
model SalonOpeningHour {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  salonId  String @map("salon_id") @db.Uuid
  weekday  Int // ISO : 1 = lundi … 7 = dimanche
  opensAt  String @map("opens_at") // "08:00" (heure locale du salon)
  closesAt String @map("closes_at") // "20:00"

  salon Salon @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, salonId, weekday])
  @@map("salon_opening_hours")
}

/// Fermetures exceptionnelles et jours fériés.
model SalonClosure {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  salonId  String   @map("salon_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)
  reason   String?

  salon Salon @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, salonId, startsAt])
  @@map("salon_closures")
}

enum ResourceType {
  CHAIR // fauteuil de coiffage
  WASH_STATION // bac à shampoing
  DRYER // casque
  ROOM // cabine
  OTHER
}

model Resource {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  salonId   String       @map("salon_id") @db.Uuid
  type      ResourceType
  name      String // « Fauteuil 3 », « Bac 1 »
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  salon Salon @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)

  busySlots        ResourceBusySlot[]
  appointmentItems AppointmentItem[]

  @@unique([tenantId, id])
  @@index([tenantId, salonId, type])
  @@map("resources")
}

// ============================================================================
// 3. ACCÈS — rôles, permissions, adhésions (utilisateur × tenant), invitations
// ============================================================================

/// Rôle d'un tenant. Les rôles système (OWNER, MANAGER…) sont créés à l'inscription.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String // "OWNER", "MANAGER", "RECEPTIONIST", "STYLIST", "ACCOUNTANT" ou code libre
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system") // non supprimable
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  permissions     RolePermission[]
  membershipRoles MembershipRole[]
  invitations     Invitation[]
  commissionRules CommissionRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  tenantId       String @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([tenantId, roleId, permissionCode])
  @@map("role_permissions")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

/// Appartenance d'un utilisateur au personnel d'un tenant.
model Membership {
  id                 String           @id @default(uuid(7)) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  status             MembershipStatus @default(ACTIVE)
  allSalons          Boolean          @default(false) @map("all_salons") // périmètre : tous les salons
  permissionsVersion Int              @default(1) @map("permissions_version") // incrémenté → jetons révoqués
  joinedAt           DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt             DateTime?        @map("left_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  roles       MembershipRole[]
  salons      MembershipSalon[]
  staffMember StaffMember?

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model MembershipRole {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, membershipId, roleId])
  @@map("membership_roles")
}

/// Périmètre : salons auxquels une adhésion donne accès (ignoré si all_salons = true).
model MembershipSalon {
  tenantId     String @map("tenant_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  salonId      String @map("salon_id") @db.Uuid

  membership Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  salon      Salon      @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, membershipId, salonId])
  @@map("membership_salons")
}

model Invitation {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  phone      String // l'invitation n'est valable que pour ce numéro
  email      String?
  roleId     String    @map("role_id") @db.Uuid
  salonIds   String[]  @map("salon_ids") @db.Uuid // vide = tous les salons
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, phone])
  @@map("invitations")
}

// ============================================================================
// 4. ÉQUIPE — employés, compétences, plannings, absences, pointage
// ============================================================================

enum StaffContractType {
  EMPLOYEE // salarié
  FREELANCE // indépendant rémunéré à la commission
  CHAIR_RENTAL // loueur de fauteuil
  APPRENTICE
}

/// Profil professionnel. Un employé peut exister sans compte (ex. apprenti sans téléphone).
model StaffMember {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  membershipId   String?           @map("membership_id") @db.Uuid
  displayName    String            @map("display_name")
  phone          String?
  photoKey       String?           @map("photo_key")
  bio            String?
  calendarColor  String            @default("#2F80ED") @map("calendar_color")
  contractType   StaffContractType @default(EMPLOYEE) @map("contract_type")
  baseSalary     BigInt?           @map("base_salary") // salaire fixe mensuel éventuel
  bookableOnline Boolean           @default(true) @map("bookable_online")
  sortOrder      Int               @default(0) @map("sort_order")
  hiredAt        DateTime?         @map("hired_at") @db.Date
  leftAt         DateTime?         @map("left_at") @db.Date
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  salons            StaffSalon[]
  skills            StaffSkill[]
  schedules         StaffSchedule[]
  timeOff           StaffTimeOff[]
  timeClockEntries  TimeClockEntry[]
  appointmentItems  AppointmentItem[]
  busySlots         StaffBusySlot[]
  waitlistPreferred WaitlistEntry[]   @relation("WaitlistPreferredStaff")
  waitlistAssigned  WaitlistEntry[]   @relation("WaitlistAssignedStaff")
  bookingHolds      BookingHold[]
  preferredBy       ClientProfile[]
  saleItems         SaleItem[]
  commissionRules   CommissionRule[]
  commissionEntries CommissionEntry[]
  payslips          Payslip[]
  advances          StaffAdvance[]
  tips              Tip[]
  reviews           Review[]

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId])
  @@map("staff_members")
}

/// Salons dans lesquels un employé travaille et peut être réservé.
model StaffSalon {
  tenantId String @map("tenant_id") @db.Uuid
  staffId  String @map("staff_id") @db.Uuid
  salonId  String @map("salon_id") @db.Uuid

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  salon Salon       @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, staffId, salonId])
  @@map("staff_salons")
}

/// Prestations qu'un employé sait réaliser, avec prix/durée spécifiques éventuels.
model StaffSkill {
  tenantId       String  @map("tenant_id") @db.Uuid
  staffId        String  @map("staff_id") @db.Uuid
  serviceId      String  @map("service_id") @db.Uuid
  priceOverride  BigInt? @map("price_override") // un senior peut être plus cher
  durationFactor Int     @default(100) @map("duration_factor") // % de la durée standard (ex. 120 = plus lent)

  staff   StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  service Service     @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, staffId, serviceId])
  @@index([tenantId, serviceId])
  @@map("staff_skills")
}

/// Planning type hebdomadaire d'un employé dans un salon.
model StaffSchedule {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  salonId   String    @map("salon_id") @db.Uuid
  weekday   Int // ISO 1–7
  startsAt  String    @map("starts_at") // "09:00"
  endsAt    String    @map("ends_at") // "18:00"
  validFrom DateTime  @default(now()) @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  salon Salon       @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, staffId, weekday])
  @@map("staff_schedules")
}

enum TimeOffType {
  LEAVE // congé
  SICK
  BREAK // pause ponctuelle
  TRAINING
  OTHER
}

model StaffTimeOff {
  id        String      @id @default(uuid(7)) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  staffId   String      @map("staff_id") @db.Uuid
  type      TimeOffType
  startsAt  DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime    @map("ends_at") @db.Timestamptz(3)
  note      String?
  createdBy String?     @map("created_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, staffId, startsAt])
  @@map("staff_time_off")
}

model TimeClockEntry {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  salonId    String    @map("salon_id") @db.Uuid
  clockInAt  DateTime  @map("clock_in_at") @db.Timestamptz(3)
  clockOutAt DateTime? @map("clock_out_at") @db.Timestamptz(3)
  source     String    @default("app") // app, admin (correction)
  note       String?

  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  salon Salon       @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, staffId, clockInAt])
  @@map("time_clock_entries")
}

// ============================================================================
// 5. CATALOGUE — catégories, prestations, variantes, étapes, forfaits
// ============================================================================

model ServiceCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String // Coupe, Coloration, Tresses, Tissage, Soins, Barbe…
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  services        Service[]
  commissionRules CommissionRule[]

  @@unique([tenantId, id])
  @@map("service_categories")
}

model Service {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  name            String
  description     String?
  basePrice       BigInt    @map("base_price")
  priceIsFrom     Boolean   @default(false) @map("price_is_from") // affiché « à partir de »
  durationMinutes Int       @map("duration_minutes") // durée totale indicative (somme des étapes)
  bookableOnline  Boolean   @default(true) @map("bookable_online")
  depositPercent  Int?      @map("deposit_percent") // null = réglage du salon
  taxRatePercent  Int       @default(0) @map("tax_rate_percent")
  imageKey        String?   @map("image_key")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category ServiceCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)

  variants         ServiceVariant[]
  steps            ServiceStep[]
  salonPrices      ServiceSalonPrice[]
  staffSkills      StaffSkill[]
  consumptions     ServiceConsumption[]
  packageItems     ServicePackageItem[]
  prepaidPackages  PrepaidPackage[]
  appointmentItems AppointmentItem[]
  waitlistEntries  WaitlistEntry[]
  bookingHolds     BookingHold[]
  saleItems        SaleItem[]
  commissionRules  CommissionRule[]

  @@unique([tenantId, id])
  @@index([tenantId, categoryId])
  @@map("services")
}

/// Variante d'une prestation (cheveux courts/longs, taille des tresses…).
model ServiceVariant {
  id              String  @id @default(uuid(7)) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  serviceId       String  @map("service_id") @db.Uuid
  name            String // « Cheveux longs », « Tresses fines »
  price           BigInt
  durationMinutes Int     @map("duration_minutes")
  sortOrder       Int     @default(0) @map("sort_order")
  isActive        Boolean @default(true) @map("is_active")

  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  appointmentItems AppointmentItem[]
  saleItems        SaleItem[]
  bookingHolds     BookingHold[]

  @@unique([tenantId, id])
  @@map("service_variants")
}

/// Étapes d'une prestation. blocks_staff = false → temps de pose : le coiffeur est libre.
model ServiceStep {
  id              String        @id @default(uuid(7)) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  serviceId       String        @map("service_id") @db.Uuid
  position        Int
  label           String // « Application », « Pose », « Rinçage »
  durationMinutes Int           @map("duration_minutes")
  blocksStaff     Boolean       @default(true) @map("blocks_staff")
  resourceType    ResourceType? @map("resource_type") // ressource requise pendant l'étape

  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, serviceId, position])
  @@map("service_steps")
}

/// Prix spécifique d'une prestation dans un salon (sinon prix de base).
model ServiceSalonPrice {
  tenantId  String  @map("tenant_id") @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  salonId   String  @map("salon_id") @db.Uuid
  price     BigInt
  isOffered Boolean @default(true) @map("is_offered") // false = prestation non proposée dans ce salon

  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  salon   Salon   @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, serviceId, salonId])
  @@map("service_salon_prices")
}

/// Forfait combinant plusieurs prestations (ex. « Mariée : coiffure + maquillage »).
model ServicePackage {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  price     BigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items ServicePackageItem[]

  @@unique([tenantId, id])
  @@map("service_packages")
}

model ServicePackageItem {
  tenantId  String @map("tenant_id") @db.Uuid
  packageId String @map("package_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid
  quantity  Int    @default(1)

  package ServicePackage @relation(fields: [tenantId, packageId], references: [tenantId, id], onDelete: Cascade)
  service Service        @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, packageId, serviceId])
  @@map("service_package_items")
}

// ============================================================================
// 6. CLIENTS (CRM)
// ============================================================================

enum Gender {
  FEMALE
  MALE
  OTHER
}

/// Fiche client d'un tenant. Existe sans compte (créée au comptoir) ; user_id rattaché ensuite.
model ClientProfile {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  clientNumber     String    @map("client_number") // numéro lisible propre au tenant
  fullName         String    @map("full_name")
  phone            String?
  whatsapp         String?
  email            String?
  birthDate        DateTime? @map("birth_date") @db.Date
  gender           Gender?
  hairType         String?   @map("hair_type") // naturel, défrisé, locks…
  preferredSalonId String?   @map("preferred_salon_id") @db.Uuid
  preferredStaffId String?   @map("preferred_staff_id") @db.Uuid
  tags             String[]
  source           String? // bouche-à-oreille, Facebook, passage…
  referredById     String?   @map("referred_by_id") @db.Uuid // parrainage
  isBlocked        Boolean   @default(false) @map("is_blocked") // réservation en ligne interdite (no-show répétés)
  // Statistiques dénormalisées, recalculées par le worker
  lastVisitAt      DateTime? @map("last_visit_at") @db.Timestamptz(3)
  visitCount       Int       @default(0) @map("visit_count")
  totalSpent       BigInt    @default(0) @map("total_spent")
  noShowCount      Int       @default(0) @map("no_show_count")
  creditBalance    BigInt    @default(0) @map("credit_balance") // avoir client
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  anonymizedAt     DateTime? @map("anonymized_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  preferredSalon Salon?          @relation(fields: [tenantId, preferredSalonId], references: [tenantId, id], onDelete: Restrict)
  preferredStaff StaffMember?    @relation(fields: [tenantId, preferredStaffId], references: [tenantId, id], onDelete: Restrict)
  referredBy     ClientProfile?  @relation("ClientReferral", fields: [tenantId, referredById], references: [tenantId, id], onDelete: Restrict)
  referrals      ClientProfile[] @relation("ClientReferral")

  consents             ClientConsent[]
  technicalNotes       ClientTechnicalNote[]
  photos               ClientPhoto[]
  notes                ClientNote[]
  appointments         Appointment[]
  waitlistEntries      WaitlistEntry[]
  bookingHolds         BookingHold[]
  sales                Sale[]
  invoices             Invoice[]
  loyaltyTransactions  LoyaltyTransaction[]
  giftCardsPurchased   GiftCard[]            @relation("GiftCardBuyer")
  giftCardsOwned       GiftCard[]            @relation("GiftCardOwner")
  clientPackages       ClientPackage[]
  promotionRedemptions PromotionRedemption[]
  campaignRecipients   CampaignRecipient[]
  notifications        Notification[]
  reviews              Review[]
  complaints           Complaint[]

  @@unique([tenantId, id])
  @@unique([tenantId, clientNumber])
  @@unique([tenantId, phone])
  @@unique([tenantId, userId])
  @@index([userId])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "client_profiles_full_name_trgm_idx")
  @@map("client_profiles")
}

enum ConsentType {
  MARKETING_SMS
  MARKETING_WHATSAPP
  MARKETING_EMAIL
  PHOTOS // prise et conservation de photos avant/après
  PHOTOS_PUBLIC // publication (réseaux sociaux, vitrine)
  TECHNICAL_DATA // conservation de la fiche technique (allergies)
}

/// Historique des consentements (une ligne par changement, jamais modifiée).
model ClientConsent {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  clientId   String      @map("client_id") @db.Uuid
  type       ConsentType
  granted    Boolean
  source     String // comptoir, réservation en ligne, lien de désinscription…
  recordedBy String?     @map("recorded_by") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  client ClientProfile @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, clientId, type, createdAt])
  @@map("client_consents")
}

/// Fiche technique : formules de coloration, sensibilités. Contenu chiffré (clé du tenant).
model ClientTechnicalNote {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  kind          String // "coloration", "allergie", "soin", "autre"
  contentEnc    String   @map("content_enc") // AES-256-GCM
  appointmentId String?  @map("appointment_id") @db.Uuid
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client      ClientProfile @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, clientId])
  @@map("client_technical_notes")
}

model ClientPhoto {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  appointmentId String?  @map("appointment_id") @db.Uuid
  storageKey    String   @map("storage_key") // bucket privé, servi par URL signée
  kind          String // "avant", "apres", "inspiration"
  caption       String?
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client      ClientProfile @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, clientId])
  @@map("client_photos")
}

model ClientNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  body      String
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  client ClientProfile @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, clientId])
  @@map("client_notes")
}

// ============================================================================
// 7. AGENDA — rendez-vous, occupations, file d'attente, blocages temporaires
// ============================================================================

enum AppointmentStatus {
  PENDING // en attente d'acompte ou de validation
  CONFIRMED
  CHECKED_IN // client arrivé
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_SALON
  NO_SHOW
}

enum BookingChannel {
  ONLINE
  COUNTER
  PHONE
  WHATSAPP
  WALK_IN
}

model Appointment {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  salonId            String            @map("salon_id") @db.Uuid
  clientId           String?           @map("client_id") @db.Uuid // null = client de passage non identifié
  reference          String // code court communiqué au client, ex. « K7P-2Q »
  status             AppointmentStatus @default(PENDING)
  channel            BookingChannel
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime          @map("ends_at") @db.Timestamptz(3)
  estimatedTotal     BigInt            @map("estimated_total")
  depositRequired    BigInt            @default(0) @map("deposit_required")
  depositPaid        BigInt            @default(0) @map("deposit_paid")
  clientNote         String?           @map("client_note") // message laissé à la réservation
  internalNote       String?           @map("internal_note")
  manageTokenHash    String?           @unique @map("manage_token_hash") // lien d'annulation/modification
  cancelledAt        DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?           @map("cancellation_reason")
  checkedInAt        DateTime?         @map("checked_in_at") @db.Timestamptz(3)
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(3)
  version            Int               @default(1)
  createdBy          String?           @map("created_by") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon  Salon          @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  client ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)

  items          AppointmentItem[]
  statusHistory  AppointmentStatusHistory[]
  technicalNotes ClientTechnicalNote[]
  photos         ClientPhoto[]
  waitlistEntry  WaitlistEntry?
  sales          Sale[]
  payments       Payment[]
  reviews        Review[]

  @@unique([tenantId, id])
  @@unique([tenantId, reference])
  @@index([tenantId, salonId, startsAt])
  @@index([tenantId, clientId, startsAt])
  @@index([tenantId, status])
  @@map("appointments")
}

/// Ligne de rendez-vous : une prestation réalisée par un employé. Prix et durée figés.
model AppointmentItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  appointmentId   String   @map("appointment_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  variantId       String?  @map("variant_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  resourceId      String?  @map("resource_id") @db.Uuid
  staffRequested  Boolean  @default(false) @map("staff_requested") // le client a choisi ce coiffeur
  position        Int
  serviceName     String   @map("service_name") // libellé figé
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  durationMinutes Int      @map("duration_minutes")
  price           BigInt

  appointment Appointment     @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  service     Service         @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  variant     ServiceVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  staff       StaffMember     @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  resource    Resource?       @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Restrict)

  staffBusySlots    StaffBusySlot[]
  resourceBusySlots ResourceBusySlot[]
  saleItems         SaleItem[]

  @@unique([tenantId, id])
  @@index([tenantId, appointmentId])
  @@index([tenantId, staffId, startsAt])
  @@map("appointment_items")
}

/// Occupation effective d'un employé (une ligne par étape bloquante).
/// La colonne générée `slot` (tstzrange) et la contrainte d'exclusion GiST sont créées
/// dans la migration securite_postgres : deux occupations actives d'un même employé ne
/// peuvent pas se chevaucher, même en cas de requêtes simultanées.
model StaffBusySlot {
  id       String                    @id @default(uuid(7)) @db.Uuid
  tenantId String                    @map("tenant_id") @db.Uuid
  staffId  String                    @map("staff_id") @db.Uuid
  itemId   String?                   @map("item_id") @db.Uuid // null pour un blocage par un hold de réservation
  holdId   String?                   @map("hold_id") @db.Uuid
  startsAt DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime                  @map("ends_at") @db.Timestamptz(3)
  isActive Boolean                   @default(true) @map("is_active") // passé à false à l'annulation
  slot     Unsupported("tstzrange")? @default(dbgenerated("tstzrange(starts_at, ends_at, '[)'::text)")) // colonne GÉNÉRÉE (migration securite_postgres), jamais écrite par l'API

  staff StaffMember      @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  item  AppointmentItem? @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)
  hold  BookingHold?     @relation(fields: [tenantId, holdId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, staffId, startsAt])
  @@map("staff_busy_slots")
}

/// Occupation d'une ressource (fauteuil, bac) — même principe que StaffBusySlot.
model ResourceBusySlot {
  id         String                    @id @default(uuid(7)) @db.Uuid
  tenantId   String                    @map("tenant_id") @db.Uuid
  resourceId String                    @map("resource_id") @db.Uuid
  itemId     String?                   @map("item_id") @db.Uuid
  holdId     String?                   @map("hold_id") @db.Uuid
  startsAt   DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime                  @map("ends_at") @db.Timestamptz(3)
  isActive   Boolean                   @default(true) @map("is_active")
  slot       Unsupported("tstzrange")? @default(dbgenerated("tstzrange(starts_at, ends_at, '[)'::text)")) // colonne GÉNÉRÉE (migration securite_postgres), jamais écrite par l'API

  resource Resource         @relation(fields: [tenantId, resourceId], references: [tenantId, id], onDelete: Restrict)
  item     AppointmentItem? @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)
  hold     BookingHold?     @relation(fields: [tenantId, holdId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, resourceId, startsAt])
  @@map("resource_busy_slots")
}

/// Blocage temporaire d'un créneau pendant le paiement de l'acompte en ligne (~10 min).
model BookingHold {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  salonId    String    @map("salon_id") @db.Uuid
  clientId   String?   @map("client_id") @db.Uuid
  serviceId  String    @map("service_id") @db.Uuid
  variantId  String?   @map("variant_id") @db.Uuid
  staffId    String    @map("staff_id") @db.Uuid
  startsAt   DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime  @map("ends_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  salon   Salon           @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Cascade)
  client  ClientProfile?  @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)
  service Service         @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  variant ServiceVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  staff   StaffMember     @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)

  staffBusySlots    StaffBusySlot[]
  resourceBusySlots ResourceBusySlot[]

  @@unique([tenantId, id])
  @@index([expiresAt])
  @@map("booking_holds")
}

model AppointmentStatusHistory {
  id            String             @id @default(uuid(7)) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  appointmentId String             @map("appointment_id") @db.Uuid
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  reason        String?
  changedBy     String?            @map("changed_by") @db.Uuid // null = client ou système
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, appointmentId])
  @@map("appointment_status_history")
}

enum WaitlistStatus {
  WAITING
  CALLED
  IN_SERVICE
  DONE
  LEFT // parti sans être servi
}

/// File d'attente des clients sans rendez-vous.
model WaitlistEntry {
  id               String         @id @default(uuid(7)) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  salonId          String         @map("salon_id") @db.Uuid
  clientId         String?        @map("client_id") @db.Uuid
  displayName      String         @map("display_name") // prénom affiché à l'écran du salon
  phone            String?
  serviceId        String?        @map("service_id") @db.Uuid
  preferredStaffId String?        @map("preferred_staff_id") @db.Uuid
  assignedStaffId  String?        @map("assigned_staff_id") @db.Uuid
  appointmentId    String?        @map("appointment_id") @db.Uuid // RDV créé à la prise en charge
  ticketNumber     Int            @map("ticket_number") // numéro du jour
  status           WaitlistStatus @default(WAITING)
  arrivedAt        DateTime       @default(now()) @map("arrived_at") @db.Timestamptz(3)
  calledAt         DateTime?      @map("called_at") @db.Timestamptz(3)
  finishedAt       DateTime?      @map("finished_at") @db.Timestamptz(3)

  salon          Salon          @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  client         ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  service        Service?       @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  preferredStaff StaffMember?   @relation("WaitlistPreferredStaff", fields: [tenantId, preferredStaffId], references: [tenantId, id], onDelete: Restrict)
  assignedStaff  StaffMember?   @relation("WaitlistAssignedStaff", fields: [tenantId, assignedStaffId], references: [tenantId, id], onDelete: Restrict)
  appointment    Appointment?   @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId])
  @@index([tenantId, salonId, status, arrivedAt])
  @@map("waitlist_entries")
}

// ============================================================================
// 8. VENTES, CAISSE, PAIEMENTS, FACTURATION, REGISTRE
// ============================================================================

enum SaleStatus {
  OPEN // ticket en cours
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED // annulé (motif obligatoire, journalisé)
}

/// Ticket de caisse. Une vente payée n'est plus modifiable : annulation ou avoir.
model Sale {
  id            String     @id @default(uuid(7)) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  salonId       String     @map("salon_id") @db.Uuid
  number        String // numéro séquentiel par tenant et par année (document_sequences)
  clientId      String?    @map("client_id") @db.Uuid
  appointmentId String?    @map("appointment_id") @db.Uuid
  cashSessionId String?    @map("cash_session_id") @db.Uuid
  status        SaleStatus @default(OPEN)
  subtotal      BigInt     @default(0) // somme des lignes avant remise globale
  discountTotal BigInt     @default(0) @map("discount_total")
  taxTotal      BigInt     @default(0) @map("tax_total")
  total         BigInt     @default(0) // à payer par le client (hors pourboires)
  tipTotal      BigInt     @default(0) @map("tip_total")
  paidTotal     BigInt     @default(0) @map("paid_total")
  currency      String     @db.Char(3)
  promotionId   String?    @map("promotion_id") @db.Uuid
  offlineId     String?    @map("offline_id") // identifiant généré par l'appareil hors ligne (idempotence)
  note          String?
  voidReason    String?    @map("void_reason")
  voidedBy      String?    @map("voided_by") @db.Uuid
  voidedAt      DateTime?  @map("voided_at") @db.Timestamptz(3)
  closedAt      DateTime?  @map("closed_at") @db.Timestamptz(3)
  version       Int        @default(1)
  createdBy     String?    @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  salon       Salon          @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  client      ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  cashSession CashSession?   @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  promotion   Promotion?     @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Restrict)

  items                SaleItem[]
  payments             Payment[]
  tips                 Tip[]
  invoices             Invoice[]
  ledgerEntries        LedgerEntry[]
  stockMovements       StockMovement[]
  loyaltyTransactions  LoyaltyTransaction[]
  giftCardTransactions GiftCardTransaction[]
  packageUsages        ClientPackageUsage[]
  promotionRedemptions PromotionRedemption[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, offlineId])
  @@index([tenantId, salonId, createdAt])
  @@index([tenantId, clientId])
  @@map("sales")
}

enum SaleItemType {
  SERVICE
  PRODUCT
  GIFT_CARD // vente d'une carte cadeau
  PREPAID_PACKAGE // vente d'un carnet
}

/// Ligne de vente. Libellé, prix et taux de commission figés au moment de la vente.
model SaleItem {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  saleId            String       @map("sale_id") @db.Uuid
  type              SaleItemType
  serviceId         String?      @map("service_id") @db.Uuid
  variantId         String?      @map("variant_id") @db.Uuid
  productId         String?      @map("product_id") @db.Uuid
  appointmentItemId String?      @map("appointment_item_id") @db.Uuid
  prepaidPackageId  String?      @map("prepaid_package_id") @db.Uuid
  staffId           String?      @map("staff_id") @db.Uuid // employé crédité (commission)
  label             String
  quantity          Int          @default(1)
  unitPrice         BigInt       @map("unit_price")
  discountAmount    BigInt       @default(0) @map("discount_amount")
  taxRatePercent    Int          @default(0) @map("tax_rate_percent")
  lineTotal         BigInt       @map("line_total") // quantity × unit_price − remise
  unitCost          BigInt?      @map("unit_cost") // coût d'achat figé (marge produits)
  paidWithPackage   Boolean      @default(false) @map("paid_with_package") // réglé par un carnet

  sale            Sale             @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  service         Service?         @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  variant         ServiceVariant?  @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  product         Product?         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  appointmentItem AppointmentItem? @relation(fields: [tenantId, appointmentItemId], references: [tenantId, id], onDelete: Restrict)
  prepaidPackage  PrepaidPackage?  @relation(fields: [tenantId, prepaidPackageId], references: [tenantId, id], onDelete: Restrict)
  staff           StaffMember?     @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  commissionEntries CommissionEntry[]
  refundItems       RefundItem[]

  @@unique([tenantId, id])
  @@index([tenantId, saleId])
  @@index([tenantId, staffId])
  @@map("sale_items")
}

/// Pourboire versé à un employé sur une vente.
model Tip {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  saleId   String @map("sale_id") @db.Uuid
  staffId  String @map("staff_id") @db.Uuid
  amount   BigInt

  sale  Sale        @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, staffId])
  @@map("tips")
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY_MANUAL // envoi au numéro du salon + référence saisie, validée par un employé
  CINETPAY
  LIGDICASH
  CARD
  BANK_TRANSFER
  GIFT_CARD
  CLIENT_CREDIT // avoir client
  LOYALTY_POINTS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Encaissement. Rattaché à une vente, ou à un rendez-vous (acompte) puis imputé à la vente.
model Payment {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  saleId            String?       @map("sale_id") @db.Uuid
  appointmentId     String?       @map("appointment_id") @db.Uuid // acompte
  cashSessionId     String?       @map("cash_session_id") @db.Uuid // obligatoire pour CASH
  giftCardId        String?       @map("gift_card_id") @db.Uuid
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            BigInt
  currency          String        @db.Char(3)
  isDeposit         Boolean       @default(false) @map("is_deposit")
  operator          String? // Orange Money, Moov Money…
  payerPhone        String?       @map("payer_phone")
  providerReference String?       @map("provider_reference") // référence opérateur / agrégateur
  idempotencyKey    String        @map("idempotency_key")
  validatedBy       String?       @map("validated_by") @db.Uuid // Mobile Money manuel
  validatedAt       DateTime?     @map("validated_at") @db.Timestamptz(3)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  failureReason     String?       @map("failure_reason")
  createdBy         String?       @map("created_by") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sale        Sale?        @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  cashSession CashSession? @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  giftCard    GiftCard?    @relation(fields: [tenantId, giftCardId], references: [tenantId, id], onDelete: Restrict)

  transactions  PaymentTransaction[]
  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, method, providerReference]) // une référence Mobile Money ne sert qu'une fois
  @@index([tenantId, saleId])
  @@index([tenantId, status, method])
  @@map("payments")
}

/// Échanges avec un agrégateur (CinetPay, LigdiCash) : initiation, webhooks, vérifications.
model PaymentTransaction {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  provider       String
  providerToken  String   @map("provider_token")
  event          String // "checkout_created", "webhook", "status_check"
  status         String
  signatureValid Boolean? @map("signature_valid")
  rawPayload     Json     @map("raw_payload")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([provider, providerToken])
  @@map("payment_transactions")
}

enum RefundMethod {
  CASH
  MOBILE_MONEY
  PROVIDER // remboursement via l'agrégateur
  CLIENT_CREDIT // transformé en avoir
}

model Refund {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  paymentId     String        @map("payment_id") @db.Uuid
  cashSessionId String?       @map("cash_session_id") @db.Uuid
  method        RefundMethod
  amount        BigInt
  reason        String
  status        PaymentStatus @default(PENDING)
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  payment     Payment      @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  cashSession CashSession? @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)

  items         RefundItem[]
  ledgerEntries LedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, paymentId])
  @@map("refunds")
}

model RefundItem {
  tenantId   String  @map("tenant_id") @db.Uuid
  refundId   String  @map("refund_id") @db.Uuid
  saleItemId String  @map("sale_item_id") @db.Uuid
  quantity   Int
  amount     BigInt
  restock    Boolean @default(false) // remettre le produit en stock

  refund   Refund   @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, refundId, saleItemId])
  @@map("refund_items")
}

model CashRegister {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  salonId   String   @map("salon_id") @db.Uuid
  name      String // « Caisse accueil »
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  salon Salon @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)

  sessions CashSession[]

  @@unique([tenantId, id])
  @@map("cash_registers")
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

/// Session de caisse : ouverture avec fond de caisse, clôture avec comptage et écart.
model CashSession {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  registerId       String            @map("register_id") @db.Uuid
  status           CashSessionStatus @default(OPEN)
  openingFloat     BigInt            @map("opening_float")
  expectedCash     BigInt?           @map("expected_cash") // calculé à la clôture
  countedCash      BigInt?           @map("counted_cash")
  difference       BigInt? // compté − attendu
  differenceReason String?           @map("difference_reason")
  openedBy         String            @map("opened_by") @db.Uuid
  openedAt         DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedBy         String?           @map("closed_by") @db.Uuid
  closedAt         DateTime?         @map("closed_at") @db.Timestamptz(3)
  version          Int               @default(1)

  register CashRegister @relation(fields: [tenantId, registerId], references: [tenantId, id], onDelete: Restrict)

  sales         Sale[]
  payments      Payment[]
  refunds       Refund[]
  movements     CashMovement[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, registerId, status])
  @@map("cash_sessions")
}

enum CashMovementType {
  CASH_IN // apport
  CASH_OUT // retrait
  BANK_DEPOSIT // dépôt en banque
}

/// Mouvement d'espèces hors vente (les dépenses payées en espèces sont dans `expenses`).
model CashMovement {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  cashSessionId String           @map("cash_session_id") @db.Uuid
  type          CashMovementType
  amount        BigInt
  reason        String
  createdBy     String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  cashSession CashSession @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, id])
  @@map("cash_movements")
}

enum InvoiceType {
  INVOICE
  CREDIT_NOTE // avoir
}

enum InvoiceStatus {
  ISSUED
  PAID
  CREDITED // annulée par un avoir
}

/// Facture ou avoir. Figée après émission (le PDF archivé fait foi).
model Invoice {
  id                String        @id @default(uuid(7)) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  salonId           String        @map("salon_id") @db.Uuid
  type              InvoiceType   @default(INVOICE)
  number            String // séquence par tenant, type et année
  status            InvoiceStatus @default(ISSUED)
  saleId            String?       @map("sale_id") @db.Uuid
  clientId          String?       @map("client_id") @db.Uuid
  creditedInvoiceId String?       @map("credited_invoice_id") @db.Uuid // pour un avoir
  // Copie figée des informations légales et du client au moment de l'émission
  sellerSnapshot    Json          @map("seller_snapshot")
  buyerSnapshot     Json?         @map("buyer_snapshot")
  subtotal          BigInt
  discountTotal     BigInt        @default(0) @map("discount_total")
  taxTotal          BigInt        @default(0) @map("tax_total")
  total             BigInt
  currency          String        @db.Char(3)
  issuedAt          DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  pdfKey            String?       @map("pdf_key")
  issuedBy          String?       @map("issued_by") @db.Uuid

  salon           Salon          @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  sale            Sale?          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  client          ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  creditedInvoice Invoice?       @relation("CreditNote", fields: [tenantId, creditedInvoiceId], references: [tenantId, id], onDelete: Restrict)
  creditNotes     Invoice[]      @relation("CreditNote")

  lines InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, type, number])
  @@index([tenantId, issuedAt])
  @@map("invoices")
}

model InvoiceLine {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  invoiceId      String @map("invoice_id") @db.Uuid
  position       Int
  label          String
  quantity       Int
  unitPrice      BigInt @map("unit_price")
  discountAmount BigInt @default(0) @map("discount_amount")
  taxRatePercent Int    @default(0) @map("tax_rate_percent")
  lineTotal      BigInt @map("line_total")

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceId, position])
  @@map("invoice_lines")
}

/// Séquences de numérotation continues par tenant, type de document et année.
model DocumentSequence {
  tenantId String @map("tenant_id") @db.Uuid
  docType  String @map("doc_type") // "SALE", "INVOICE", "CREDIT_NOTE", "PURCHASE_ORDER", "CLIENT"
  year     Int
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, docType, year])
  @@map("document_sequences")
}

enum LedgerAccount {
  CASH // espèces en caisse
  MOBILE_MONEY // compte Mobile Money du salon
  PROVIDER_CLEARING // fonds chez l'agrégateur, non encore reversés
  BANK
  REVENUE_SERVICES
  REVENUE_PRODUCTS
  DISCOUNTS
  TAX_COLLECTED
  TIPS_PAYABLE // pourboires dus aux employés
  DEPOSITS_HELD // acomptes reçus non encore consommés
  GIFT_CARD_LIABILITY // cartes cadeaux vendues non utilisées
  PACKAGE_LIABILITY // carnets prépayés non consommés
  CLIENT_CREDIT // avoirs clients
  EXPENSES
  CASH_DIFFERENCE // écarts de caisse
  OWNER_EQUITY // apports et retraits du propriétaire (mouvements d'espèces hors vente)
}

/// Registre en partie double : chaque opération d'argent produit des lignes dont la somme
/// des débits égale la somme des crédits (même transaction_group).
model LedgerEntry {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  salonId          String        @map("salon_id") @db.Uuid
  transactionGroup String        @map("transaction_group") @db.Uuid
  account          LedgerAccount
  debit            BigInt        @default(0)
  credit           BigInt        @default(0)
  currency         String        @db.Char(3)
  saleId           String?       @map("sale_id") @db.Uuid
  paymentId        String?       @map("payment_id") @db.Uuid
  refundId         String?       @map("refund_id") @db.Uuid
  cashSessionId    String?       @map("cash_session_id") @db.Uuid
  cashMovementId   String?       @map("cash_movement_id") @db.Uuid
  expenseId        String?       @map("expense_id") @db.Uuid
  description      String?
  occurredAt       DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  sale         Sale?         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  payment      Payment?      @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  refund       Refund?       @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Restrict)
  cashSession  CashSession?  @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  cashMovement CashMovement? @relation(fields: [tenantId, cashMovementId], references: [tenantId, id], onDelete: Restrict)
  expense      Expense?      @relation(fields: [tenantId, expenseId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, transactionGroup])
  @@index([tenantId, salonId, account, occurredAt])
  @@map("ledger_entries")
}

// ============================================================================
// 9. DÉPENSES
// ============================================================================

model ExpenseCategory {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String // Loyer, Électricité, Eau, Salaires, Produits, Transport…
  isActive Boolean @default(true) @map("is_active")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("expense_categories")
}

enum ExpensePaymentMethod {
  CASH // payée depuis la caisse → cash_session_id obligatoire
  MOBILE_MONEY
  BANK_TRANSFER
  CHEQUE
  OTHER
}

model Expense {
  id              String               @id @default(uuid(7)) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  salonId         String               @map("salon_id") @db.Uuid
  categoryId      String               @map("category_id") @db.Uuid
  supplierId      String?              @map("supplier_id") @db.Uuid
  purchaseOrderId String?              @map("purchase_order_id") @db.Uuid
  cashSessionId   String?              @map("cash_session_id") @db.Uuid
  payrollPeriodId String?              @map("payroll_period_id") @db.Uuid
  label           String
  amount          BigInt
  currency        String               @db.Char(3)
  paymentMethod   ExpensePaymentMethod @map("payment_method")
  reference       String? // n° de pièce, référence de transfert
  receiptKey      String?              @map("receipt_key") // justificatif scanné
  spentAt         DateTime             @map("spent_at") @db.Date
  createdBy       String               @map("created_by") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt       DateTime?            @map("deleted_at") @db.Timestamptz(3)

  salon         Salon           @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  category      ExpenseCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  supplier      Supplier?       @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?  @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)
  cashSession   CashSession?    @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  payrollPeriod PayrollPeriod?  @relation(fields: [tenantId, payrollPeriodId], references: [tenantId, id], onDelete: Restrict)

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, id])
  @@index([tenantId, salonId, spentAt])
  @@map("expenses")
}

// ============================================================================
// 10. STOCK — produits, stock par salon, mouvements, fournisseurs, achats, transferts
// ============================================================================

model Supplier {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  products       Product[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([tenantId, id])
  @@map("suppliers")
}

enum ProductKind {
  RETAIL // revente au client
  PROFESSIONAL // consommé pendant les prestations (mèches, colorations…)
  BOTH
}

model Product {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  supplierId     String?     @map("supplier_id") @db.Uuid
  name           String
  brand          String?
  sku            String?
  barcode        String?
  kind           ProductKind
  unit           String      @default("pièce") // pièce, paquet, ml, g
  purchasePrice  BigInt      @map("purchase_price") // dernier prix d'achat
  salePrice      BigInt?     @map("sale_price") // null si non revendu
  taxRatePercent Int         @default(0) @map("tax_rate_percent")
  imageKey       String?     @map("image_key")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  stocks             ProductStock[]
  movements          StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  transferLines      StockTransferLine[]
  consumptions       ServiceConsumption[]
  saleItems          SaleItem[]
  commissionRules    CommissionRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@map("products")
}

/// Stock courant d'un produit dans un salon (maintenu par les mouvements).
model ProductStock {
  tenantId       String   @map("tenant_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  salonId        String   @map("salon_id") @db.Uuid
  quantity       Decimal  @default(0) @db.Decimal(12, 3) // décimal pour ml/g
  alertThreshold Decimal? @map("alert_threshold") @db.Decimal(12, 3)
  averageCost    BigInt   @default(0) @map("average_cost") // coût moyen pondéré
  version        Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  salon   Salon   @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, productId, salonId])
  @@map("product_stocks")
}

enum StockMovementType {
  PURCHASE_RECEIPT // réception fournisseur
  SALE // vente au client
  CONSUMPTION // utilisé pendant une prestation
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT // inventaire
  LOSS // casse, péremption, vol
  RETURN // retour client
}

/// Journal des mouvements (jamais modifié). quantity > 0 entrée, < 0 sortie.
model StockMovement {
  id                  String            @id @default(uuid(7)) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  salonId             String            @map("salon_id") @db.Uuid
  productId           String            @map("product_id") @db.Uuid
  type                StockMovementType
  quantity            Decimal           @db.Decimal(12, 3)
  unitCost            BigInt?           @map("unit_cost")
  saleId              String?           @map("sale_id") @db.Uuid
  purchaseOrderLineId String?           @map("purchase_order_line_id") @db.Uuid
  transferId          String?           @map("transfer_id") @db.Uuid
  reason              String?
  createdBy           String?           @map("created_by") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  salon             Salon              @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  product           Product            @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  sale              Sale?              @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [tenantId, purchaseOrderLineId], references: [tenantId, id], onDelete: Restrict)
  transfer          StockTransfer?     @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, salonId, productId, createdAt])
  @@map("stock_movements")
}

/// Consommation type d'un produit par prestation (décrément automatique du stock).
model ServiceConsumption {
  tenantId  String  @map("tenant_id") @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @db.Decimal(12, 3)

  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, serviceId, productId])
  @@map("service_consumptions")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(uuid(7)) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  salonId    String              @map("salon_id") @db.Uuid
  supplierId String              @map("supplier_id") @db.Uuid
  number     String
  status     PurchaseOrderStatus @default(DRAFT)
  total      BigInt              @default(0)
  currency   String              @db.Char(3)
  orderedAt  DateTime?           @map("ordered_at") @db.Timestamptz(3)
  receivedAt DateTime?           @map("received_at") @db.Timestamptz(3)
  note       String?
  createdBy  String              @map("created_by") @db.Uuid
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  salon    Salon    @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  lines    PurchaseOrderLine[]
  expenses Expense[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @default(uuid(7)) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitCost         BigInt  @map("unit_cost")

  purchaseOrder PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)
  product       Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  movements StockMovement[]

  @@unique([tenantId, id])
  @@map("purchase_order_lines")
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

/// Transfert de stock entre deux salons du même tenant.
model StockTransfer {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  fromSalonId String              @map("from_salon_id") @db.Uuid
  toSalonId   String              @map("to_salon_id") @db.Uuid
  status      StockTransferStatus @default(DRAFT)
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz(3)
  receivedAt  DateTime?           @map("received_at") @db.Timestamptz(3)
  createdBy   String              @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  fromSalon Salon @relation("TransferFrom", fields: [tenantId, fromSalonId], references: [tenantId, id], onDelete: Restrict)
  toSalon   Salon @relation("TransferTo", fields: [tenantId, toSalonId], references: [tenantId, id], onDelete: Restrict)

  lines     StockTransferLine[]
  movements StockMovement[]

  @@unique([tenantId, id])
  @@map("stock_transfers")
}

model StockTransferLine {
  tenantId   String  @map("tenant_id") @db.Uuid
  transferId String  @map("transfer_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Decimal @db.Decimal(12, 3)

  transfer StockTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, transferId, productId])
  @@map("stock_transfer_lines")
}

// ============================================================================
// 11. COMMISSIONS ET PAIE
// ============================================================================

enum CommissionType {
  PERCENT
  FIXED
}

/// Règle de commission. La plus spécifique l'emporte :
/// employé + prestation/produit > employé + catégorie > employé > rôle > tenant.
model CommissionRule {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  staffId           String?        @map("staff_id") @db.Uuid
  roleId            String?        @map("role_id") @db.Uuid
  serviceCategoryId String?        @map("service_category_id") @db.Uuid
  serviceId         String?        @map("service_id") @db.Uuid
  productId         String?        @map("product_id") @db.Uuid
  appliesTo         SaleItemType   @map("applies_to") // SERVICE ou PRODUCT
  type              CommissionType
  value             Int // pourcentage (ex. 30) ou montant fixe
  minMonthlyRevenue BigInt?        @map("min_monthly_revenue") // palier : s'applique au-delà de ce CA mensuel
  validFrom         DateTime       @default(now()) @map("valid_from") @db.Date
  validTo           DateTime?      @map("valid_to") @db.Date
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff           StaffMember?     @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  role            Role?            @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [tenantId, serviceCategoryId], references: [tenantId, id], onDelete: Cascade)
  service         Service?         @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Cascade)
  product         Product?         @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  entries CommissionEntry[]

  @@unique([tenantId, id])
  @@map("commission_rules")
}

/// Commission calculée pour une ligne de vente (figée ; négative en cas de remboursement).
model CommissionEntry {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  saleItemId      String   @map("sale_item_id") @db.Uuid
  ruleId          String?  @map("rule_id") @db.Uuid
  baseAmount      BigInt   @map("base_amount")
  amount          BigInt
  payrollPeriodId String?  @map("payroll_period_id") @db.Uuid
  earnedAt        DateTime @map("earned_at") @db.Timestamptz(3)

  staff         StaffMember     @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  saleItem      SaleItem        @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)
  rule          CommissionRule? @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Restrict)
  payrollPeriod PayrollPeriod?  @relation(fields: [tenantId, payrollPeriodId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, staffId, earnedAt])
  @@map("commission_entries")
}

enum PayrollStatus {
  DRAFT
  VALIDATED
  PAID
}

model PayrollPeriod {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  status      PayrollStatus @default(DRAFT)
  validatedBy String?       @map("validated_by") @db.Uuid
  validatedAt DateTime?     @map("validated_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  payslips          Payslip[]
  commissionEntries CommissionEntry[]
  advances          StaffAdvance[]
  expenses          Expense[]

  @@unique([tenantId, id])
  @@unique([tenantId, periodStart, periodEnd])
  @@map("payroll_periods")
}

/// Relevé de rémunération d'un employé sur une période.
model Payslip {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  payrollPeriodId  String    @map("payroll_period_id") @db.Uuid
  staffId          String    @map("staff_id") @db.Uuid
  baseSalary       BigInt    @default(0) @map("base_salary")
  commissionsTotal BigInt    @default(0) @map("commissions_total")
  tipsTotal        BigInt    @default(0) @map("tips_total")
  advancesTotal    BigInt    @default(0) @map("advances_total")
  otherAdjustments BigInt    @default(0) @map("other_adjustments")
  netAmount        BigInt    @map("net_amount")
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(3)

  payrollPeriod PayrollPeriod @relation(fields: [tenantId, payrollPeriodId], references: [tenantId, id], onDelete: Cascade)
  staff         StaffMember   @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, payrollPeriodId, staffId])
  @@map("payslips")
}

model StaffAdvance {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  payrollPeriodId String?  @map("payroll_period_id") @db.Uuid // période où elle est déduite
  amount          BigInt
  note            String?
  givenAt         DateTime @map("given_at") @db.Timestamptz(3)
  createdBy       String   @map("created_by") @db.Uuid

  staff         StaffMember    @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)
  payrollPeriod PayrollPeriod? @relation(fields: [tenantId, payrollPeriodId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("staff_advances")
}

// ============================================================================
// 12. FIDÉLITÉ, CARTES CADEAUX, CARNETS (abonnements clients), PROMOTIONS
// ============================================================================

model LoyaltyProgram {
  tenantId          String   @id @map("tenant_id") @db.Uuid
  isActive          Boolean  @default(false) @map("is_active")
  pointsPerUnit     Int      @default(1) @map("points_per_unit") // points gagnés…
  unitAmount        BigInt   @default(1000) @map("unit_amount") // …par tranche de X FCFA dépensés
  pointValue        BigInt   @default(10) @map("point_value") // valeur d'un point à l'utilisation
  minPointsToRedeem Int      @default(100) @map("min_points_to_redeem")
  pointsExpireDays  Int?     @map("points_expire_days")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

/// Journal des points (le solde = somme des points du client).
model LoyaltyTransaction {
  id        String                 @id @default(uuid(7)) @db.Uuid
  tenantId  String                 @map("tenant_id") @db.Uuid
  clientId  String                 @map("client_id") @db.Uuid
  saleId    String?                @map("sale_id") @db.Uuid
  type      LoyaltyTransactionType
  points    Int // positif ou négatif
  expiresAt DateTime?              @map("expires_at") @db.Timestamptz(3)
  note      String?
  createdBy String?                @map("created_by") @db.Uuid
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  client ClientProfile @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  sale   Sale?         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, clientId, createdAt])
  @@map("loyalty_transactions")
}

enum GiftCardStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

model GiftCard {
  id            String         @id @default(uuid(7)) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  codeHash      String         @map("code_hash") // le code n'est jamais stocké en clair
  codeLast4     String         @map("code_last4")
  initialAmount BigInt         @map("initial_amount")
  balance       BigInt
  currency      String         @db.Char(3)
  status        GiftCardStatus @default(ACTIVE)
  buyerClientId String?        @map("buyer_client_id") @db.Uuid
  ownerClientId String?        @map("owner_client_id") @db.Uuid
  recipientName String?        @map("recipient_name")
  expiresAt     DateTime?      @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  buyerClient ClientProfile? @relation("GiftCardBuyer", fields: [tenantId, buyerClientId], references: [tenantId, id], onDelete: Restrict)
  ownerClient ClientProfile? @relation("GiftCardOwner", fields: [tenantId, ownerClientId], references: [tenantId, id], onDelete: Restrict)

  transactions GiftCardTransaction[]
  payments     Payment[]

  @@unique([tenantId, id])
  @@unique([tenantId, codeHash])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  giftCardId String   @map("gift_card_id") @db.Uuid
  saleId     String?  @map("sale_id") @db.Uuid
  amount     BigInt // + chargement, − utilisation
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  giftCard GiftCard @relation(fields: [tenantId, giftCardId], references: [tenantId, id], onDelete: Restrict)
  sale     Sale?    @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("gift_card_transactions")
}

/// Carnet / abonnement client vendu par le salon (ex. « 10 brushings », « 4 tresses par an »).
model PrepaidPackage {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  name         String
  sessions     Int // nombre de séances
  price        BigInt
  validityDays Int?     @map("validity_days")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)

  clientPackages ClientPackage[]
  saleItems      SaleItem[]

  @@unique([tenantId, id])
  @@map("prepaid_packages")
}

enum ClientPackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

model ClientPackage {
  id               String              @id @default(uuid(7)) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  clientId         String              @map("client_id") @db.Uuid
  prepaidPackageId String              @map("prepaid_package_id") @db.Uuid
  sessionsTotal    Int                 @map("sessions_total")
  sessionsUsed     Int                 @default(0) @map("sessions_used")
  pricePaid        BigInt              @map("price_paid")
  status           ClientPackageStatus @default(ACTIVE)
  purchasedAt      DateTime            @default(now()) @map("purchased_at") @db.Timestamptz(3)
  expiresAt        DateTime?           @map("expires_at") @db.Timestamptz(3)

  client         ClientProfile  @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  prepaidPackage PrepaidPackage @relation(fields: [tenantId, prepaidPackageId], references: [tenantId, id], onDelete: Restrict)

  usages ClientPackageUsage[]

  @@unique([tenantId, id])
  @@index([tenantId, clientId, status])
  @@map("client_packages")
}

model ClientPackageUsage {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  clientPackageId String   @map("client_package_id") @db.Uuid
  saleId          String   @map("sale_id") @db.Uuid
  sessions        Int      @default(1)
  usedAt          DateTime @default(now()) @map("used_at") @db.Timestamptz(3)

  clientPackage ClientPackage @relation(fields: [tenantId, clientPackageId], references: [tenantId, id], onDelete: Restrict)
  sale          Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@map("client_package_usages")
}

enum PromotionType {
  PERCENT
  FIXED_AMOUNT
}

model Promotion {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  code             String? // null = promotion automatique (ex. mardi -20 %)
  name             String
  type             PromotionType
  value            BigInt // % ou montant
  minPurchase      BigInt?       @map("min_purchase")
  serviceIds       String[]      @map("service_ids") @db.Uuid // vide = toutes les prestations
  salonIds         String[]      @map("salon_ids") @db.Uuid // vide = tous les salons
  maxUses          Int?          @map("max_uses")
  maxUsesPerClient Int?          @map("max_uses_per_client")
  usedCount        Int           @default(0) @map("used_count")
  startsAt         DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?     @map("ends_at") @db.Timestamptz(3)
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  sales       Sale[]
  redemptions PromotionRedemption[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("promotions")
}

model PromotionRedemption {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  promotionId String   @map("promotion_id") @db.Uuid
  saleId      String   @map("sale_id") @db.Uuid
  clientId    String?  @map("client_id") @db.Uuid
  amount      BigInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  promotion Promotion      @relation(fields: [tenantId, promotionId], references: [tenantId, id], onDelete: Restrict)
  sale      Sale           @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  client    ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, promotionId, clientId])
  @@map("promotion_redemptions")
}

// ============================================================================
// 13. COMMUNICATION — modèles, envois, campagnes, notifications push
// ============================================================================

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED // pas de consentement, pas de canal, quota atteint
}

/// Modèle de message par événement et par canal (surcharge des modèles par défaut).
model NotificationTemplate {
  id        String              @id @default(uuid(7)) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  event     String // "appointment.confirmed", "appointment.reminder_24h", "birthday"…
  channel   NotificationChannel
  subject   String?
  body      String // variables : {{client.prenom}}, {{rdv.date}}…
  isActive  Boolean             @default(true) @map("is_active")
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, event, channel])
  @@map("notification_templates")
}

/// Journal des envois (clients ou employés).
model Notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  clientId          String?             @map("client_id") @db.Uuid
  recipientUserId   String?             @map("recipient_user_id") @db.Uuid // employé destinataire
  channel           NotificationChannel
  event             String
  destination       String? // numéro, email, endpoint push (masqué dans l'interface)
  title             String?
  body              String
  actionUrl         String?             @map("action_url") // lien dans l'application
  /// Clé d'unicité : une même alerte n'est jamais envoyée deux fois (planificateur rejouable).
  dedupeKey         String?             @map("dedupe_key")
  status            NotificationStatus  @default(QUEUED)
  campaignId        String?             @map("campaign_id") @db.Uuid
  relatedEntity     String?             @map("related_entity") // "appointment:<id>"
  providerMessageId String?             @map("provider_message_id")
  costUnits         Int                 @default(0) @map("cost_units") // SMS facturés
  error             String?
  scheduledFor      DateTime?           @map("scheduled_for") @db.Timestamptz(3)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt            DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  client   ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  campaign Campaign?      @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, dedupeKey])
  @@index([tenantId, clientId, createdAt])
  @@index([tenantId, recipientUserId, createdAt])
  @@index([status, scheduledFor])
  @@map("notifications")
}

/// Abonnement Web Push d'un appareil (identité globale, pas de tenant).
model PushSubscription {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

model Campaign {
  id             String              @id @default(uuid(7)) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  name           String
  channel        NotificationChannel
  body           String
  segment        Json // critères : salon, dernière visite, tags, anniversaire…
  status         CampaignStatus      @default(DRAFT)
  scheduledAt    DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  recipientCount Int                 @default(0) @map("recipient_count")
  createdBy      String              @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  recipients    CampaignRecipient[]
  notifications Notification[]

  @@unique([tenantId, id])
  @@map("campaigns")
}

model CampaignRecipient {
  tenantId   String             @map("tenant_id") @db.Uuid
  campaignId String             @map("campaign_id") @db.Uuid
  clientId   String             @map("client_id") @db.Uuid
  status     NotificationStatus @default(QUEUED)

  campaign Campaign      @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  client   ClientProfile @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, campaignId, clientId])
  @@map("campaign_recipients")
}

// ============================================================================
// 14. QUALITÉ — avis, réclamations
// ============================================================================

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model Review {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  salonId       String       @map("salon_id") @db.Uuid
  clientId      String?      @map("client_id") @db.Uuid
  appointmentId String?      @map("appointment_id") @db.Uuid
  staffId       String?      @map("staff_id") @db.Uuid
  rating        Int // 1 à 5
  comment       String?
  status        ReviewStatus @default(PENDING)
  reply         String?
  repliedBy     String?      @map("replied_by") @db.Uuid
  repliedAt     DateTime?    @map("replied_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  salon       Salon          @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  client      ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  staff       StaffMember?   @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId]) // un avis par rendez-vous
  @@index([tenantId, salonId, status])
  @@map("reviews")
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Complaint {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  salonId     String          @map("salon_id") @db.Uuid
  clientId    String?         @map("client_id") @db.Uuid
  subject     String
  description String
  status      ComplaintStatus @default(OPEN)
  resolution  String?
  handledBy   String?         @map("handled_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt  DateTime?       @map("resolved_at") @db.Timestamptz(3)

  salon  Salon          @relation(fields: [tenantId, salonId], references: [tenantId, id], onDelete: Restrict)
  client ClientProfile? @relation(fields: [tenantId, clientId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("complaints")
}

// ============================================================================
// 15. TECHNIQUE — intégrations, audit, événements
// ============================================================================

model WebhookEndpoint {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  url       String
  events    String[] // événements souscrits
  secretEnc String   @map("secret_enc") // secret de signature HMAC, chiffré
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@map("webhook_endpoints")
}

model ApiKey {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  prefix      String    @unique // partie visible, ex. « sk_live_ab12 »
  keyHash     String    @map("key_hash")
  permissions String[] // sous-ensemble du catalogue
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@map("api_keys")
}

/// Journal d'audit en ajout seul (UPDATE/DELETE interdits par trigger).
/// tenant_id null = action de niveau plateforme.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  impersonatedBy String?  @map("impersonated_by") @db.Uuid // agent support agissant pour le compte
  action         String // "sale.void", "role.update", "price.update", "client.export"…
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  salonId        String?  @map("salon_id") @db.Uuid
  before         Json?
  after          Json?
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Événements métier écrits dans la même transaction que la donnée, publiés ensuite vers BullMQ.
model OutboxEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  type        String // "appointment.confirmed", "sale.paid"…
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?      @map("last_error")
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_events")
}
