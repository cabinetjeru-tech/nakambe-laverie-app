DATABASE_URL="postgresql://nakambe:CHANGE_ME@localhost:5432/nakambe_db?schema=public"

JWT_ACCESS_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3001
FRONTEND_URL="http://localhost:3000"
# Adresse publique de CE backend, utilisée pour recevoir les notifications de paiement LigdiCash.
BACKEND_PUBLIC_URL="http://localhost:3001"

# Paiement Mobile Money en ligne — fournisseur actif : "CINETPAY" ou "LIGDICASH".
ONLINE_PAYMENT_PROVIDER="CINETPAY"

# CinetPay — clés obtenues depuis votre tableau de bord CinetPay (Intégration > Clé API).
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""

# Assistant IA (questions générales et guidage, espace client + site) — clé obtenue sur console.anthropic.com.
ANTHROPIC_API_KEY=""

# LigdiCash (fournisseur de secours) — clés obtenues depuis votre tableau de bord LigdiCash.
LIGDICASH_API_KEY=""
LIGDICASH_AUTH_TOKEN=""
LIGDICASH_PLATFORM="test"

COMPANY_NAME="NAKAMBÉ LAVERIE EXPRES ET DIGITALE"
COMPANY_SLOGAN="Laverie express et digitale"
COMPANY_ADDRESS="Cité du 11 Décembre, Tenkodogo, Burkina Faso"
COMPANY_PHONE_1="+226 73 12 26 12"
COMPANY_PHONE_2="+226 54 54 28 18"

# SMTP (optionnel — laisser vide pour désactiver l'envoi d'email)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
