{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/rappels",
      "schedule": "0 8 * * *"
    }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] || git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- ."
}
