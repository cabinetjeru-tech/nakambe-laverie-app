# Clé API Anthropic (obligatoire) — https://platform.claude.com
ANTHROPIC_API_KEY=

# Modèle et niveau de réflexion (facultatifs)
KIBARU_MODEL=claude-opus-5
# low | medium | high  (medium : bon équilibre qualité / coût pour des fiches et devoirs)
KIBARU_EFFORT=medium

# Code d'accès partagé avec les enseignants autorisés (fortement recommandé en ligne :
# sans code, toute personne connaissant l'adresse peut utiliser l'assistant à vos frais).
KIBARU_ACCESS_CODE=

# Secret de signature du cookie d'accès (générer avec : openssl rand -base64 32)
KIBARU_SESSION_SECRET=

# Nombre maximal de demandes par minute et par adresse IP
KIBARU_RATE_LIMIT=12
