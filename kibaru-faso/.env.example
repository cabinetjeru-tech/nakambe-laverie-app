# Clé API Anthropic (obligatoire) — https://platform.claude.com
ANTHROPIC_API_KEY=

# Modèle et niveau de réflexion (facultatifs)
KIBARU_MODEL=claude-opus-5
# low | medium | high  (medium : bon équilibre qualité / coût pour des fiches et devoirs)
KIBARU_EFFORT=medium

# Code d'accès partagé avec les enseignants autorisés (fortement recommandé en ligne :
# sans code, toute personne connaissant l'adresse peut utiliser l'assistant à vos frais).
KIBARU_ACCESS_CODE=

# Secret de signature du cookie d'accès (générer avec : openssl rand -base64 32)
KIBARU_SESSION_SECRET=

# Nombre maximal de demandes par minute et par adresse IP
KIBARU_RATE_LIMIT=12

# --- Comptes enseignants, abonnements, administration (Supabase) ---
# Sans ces trois variables, l'application garde l'accès par code partagé ci-dessus.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (Supabase → Project Settings → API Keys → Secret keys). Ne jamais la publier.
SUPABASE_SECRET_KEY=
# Adresses e-mail des administrateurs, séparées par des virgules
ADMIN_EMAILS=
# Adresse publique de l'application (liens de retour de paiement), ex. https://pedagogue-ia.vercel.app
APP_URL=

# --- Paiement mobile money (CinetPay : Orange Money, Moov Money) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# ALL (mobile money + carte, défaut), MOBILE_MONEY ou CREDIT_CARD
CINETPAY_CHANNELS=ALL

# Commission de parrainage en % sur chaque abonnement mensuel ou annuel d'un filleul (défaut 10)
PARRAINAGE_TAUX=10
# Générations offertes à l'inscription (1 = une fiche gratuite)
QUOTA_ESSAI=1

# ── WhatsApp professionnel (API WhatsApp Cloud de Meta) : agent IA de renseignement — voir docs/WHATSAPP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Phrase secrète de votre choix, à recopier à l'identique chez Meta (configuration du webhook)
WHATSAPP_VERIFY_TOKEN=
# Facultatif : plafonds de réponses IA (coût) et modèle
WHATSAPP_MAX_REPONSES_JOUR=300
WHATSAPP_MAX_PAR_CONTACT_JOUR=30
# WHATSAPP_MODEL=claude-sonnet-5-5
# WHATSAPP_API_VERSION=v23.0
